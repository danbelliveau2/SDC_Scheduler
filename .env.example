# SDC Scheduler — environment configuration.
# Copy to `.env` and fill in the values you need. Anything you leave commented
# stays disabled (auth off, no Azure sync, no email).

PORT=3000

# ─── Phase 3 — Auth ──────────────────────────────────────────────────────
# Set AUTH_ENABLED=true to require a JWT on every /api/* request. Run
#   node create-admin.js --email you@sdc.com --name "Your Name" --password "..."
# BEFORE flipping this on so you have a way to sign in.
AUTH_ENABLED=false
JWT_SECRET=change-this-to-a-random-64-char-string

# ─── Phase 6 — Azure SQL bidirectional sync (optional) ───────────────────
# Leave these empty to keep all data local in scheduler.db. When all four are
# set, server.js boots the azureSync watchers and pushes inserts/updates to
# the cloud (and pulls cloud changes back) every few seconds.
AZURE_SQL_SERVER=
AZURE_SQL_DATABASE=
AZURE_SQL_USER=
AZURE_SQL_PASSWORD=

# ─── Phase 7 — Email notifications (optional) ────────────────────────────
# Leave SMTP_HOST empty to disable emails (mentions still get logged to
# notification_log, just no SMTP delivery). Resend.com free tier works well.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SDC Scheduler <noreply@yourdomain.com>

# ─── Job Hours — Power BI semantic model (optional) ─────────────────────
# Enabled automatically when sdc-powerbi-mcp.exe exists at its default path.
# Auth uses the exe's locally-cached Entra token (run `exe login` once).
# Override the path only if the exe moves:
# PBI_MCP_EXE=D:\path\to\sdc-powerbi-mcp.exe

# ─── Integration API — Build Readiness Report reads project dates here ───
# (routes/integration.js). MUST match the same var in
# Build_Readiness_Report/.env.
READINESS_SHARED_TOKEN=change-this-to-a-random-64-char-string

# ─── SDC Tools centralized login (routes/ssoCentral.js) ──────────────────
# Scheduler acts as the identity broker for the whole SDC Tools suite: it
# verifies the Electron shell's own Azure AD (Entra ID) login and turns it
# into (a) a normal Scheduler session and (b) a shared session the other 4
# apps (Assemblies Library, Build Readiness Report, State Logic Builder,
# Calendar) verify via their own sdcSessionAuth.js. Leave AZURE_TENANT_ID /
# AZURE_CLIENT_ID blank to leave POST /api/auth/entra-exchange disabled
# (503) — no behavior change to anything else.
#
# Must be the SAME Azure AD app registration (tenant + client id) the shell
# itself uses to log in — see Centrailized library/shell/.env.example.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# Shared secret this app mints the sdcSession token with. Same value must be
# set on every app that verifies it (Assemblies Library, Build Readiness
# Report, State Logic Builder, Calendar) — see each of their .env.example.
SDC_SESSION_SECRET=change-this-to-a-random-64-char-string

# ─── SDC Tools ↔ SDC ETC Planner (Reports) SSO hand-off ──────────────────
# Two independent uses of the SAME shared secret: user SSO (routes/auth.js's
# /api/auth/sso inbound, /api/auth/mint-etc-sso outbound — the sign-in
# hand-off both directions, plus what the Electron shell's
# mintEtcSsoHopToken() calls to open Reports pre-signed-in) and password-hash
# sync (routes/auth.js's sync-password / password-hash endpoints, so the
# same person's password stays identical on both apps' own native login
# forms). MUST match the identically-named SCHEDULER_SHARED_TOKEN in the
# Reports app's own .env — see D:\AI Projects\sdc-etc-planner.
SCHEDULER_SHARED_TOKEN=change-this-to-a-random-64-char-string
