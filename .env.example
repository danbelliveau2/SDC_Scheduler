# SDC Scheduler — environment configuration.
# Copy to `.env` and fill in the values you need. Anything you leave commented
# stays disabled (auth off, no email, no AI assistant, no Power BI bridge).

PORT=3000

# ── MySQL — primary database (required) ──────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=sdc_scheduler

# ─── Phase 3 — Auth ──────────────────────────────────────────────────────
# Set AUTH_ENABLED=true to require a JWT on every /api/* request. Run
#   node create-admin.js --email you@sdc.com --name "Your Name" --password "..."
# BEFORE flipping this on so you have a way to sign in.
AUTH_ENABLED=false
JWT_SECRET=change-this-to-a-random-64-char-string

# ─── Phase 7 — Email notifications (optional) ────────────────────────────
# Leave SMTP_HOST empty to disable emails (mentions still get logged to
# notification_log, just no SMTP delivery). Resend.com free tier works well.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SDC Scheduler <noreply@yourdomain.com>

# Base URL used to build links in outbound emails (mention/digest
# notifications). If unset, lib/emailService.js falls back to
# http://localhost:3000 — real recipients would get dead links.
APP_URL=http://SERVER-APP1:4003

# ─── GitHub token (optional) ─────────────────────────────────────────────
# Used by admin/ops tooling that reads this repo's GitHub API. Leave blank if
# not needed.
GITHUB_TOKEN=

# ─── Anthropic Claude Assistant (optional) ───────────────────────────────
# Powers the "✨ Ask" assistant chatbot with conversation memory.
# Get your key from https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=1024

# ─── Total ETO bridge (optional — procurement + job hours features) ──────
ETO_HOST=SERVER-APP1.stevendouglas.local
ETO_DATABASE=SDC
ETO_PORT=1433
ETO_DOMAIN=stevendouglas
ETO_USER=your_user
ETO_PASSWORD=your_password

# ─── Job Hours — Power BI semantic model (optional) ─────────────────────
# Enabled automatically when sdc-powerbi-mcp.exe exists at its default path
# (../SDC-PowerBI-DEV/mcp-server/publish/win-x64-new/, relative to this app).
# PBI_CACHE_PATH points to a plain JSON token cache (no DPAPI) so the
# LocalSystem PM2 process can read it. Created by running:
#   set PBI_CACHE_PATH=<path> && sdc-powerbi-mcp.exe login
# Refresh tokens last 90 days; re-run login if it stops working.
# PBI_CACHE_PATH=D:\path\to\pbi_cache.json
# Override only if the exe moves from its default sibling-folder location:
# PBI_MCP_EXE=D:\path\to\sdc-powerbi-mcp.exe

# ─── SDC Tools centralized login (routes/ssoCentral.js) ──────────────────
# Scheduler acts as the identity broker for the whole SDC Tools suite: it
# verifies the Electron shell's own Azure AD (Entra ID) login and turns it
# into (a) a normal Scheduler session and (b) a shared session the other 4
# apps (Assemblies Library, Build Readiness Report, State Logic Builder,
# Calendar) verify via their own sdcSessionAuth.js. Leave AZURE_TENANT_ID /
# AZURE_CLIENT_ID blank to leave POST /api/auth/entra-exchange disabled
# (503) — no behavior change to anything else.
#
# Must be the SAME Azure AD app registration (tenant + client id) the shell
# itself uses to log in — see apps/shell/.env.example.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# Shared secret this app mints the sdcSession token with. Same value must be
# set on every app that verifies it (Assemblies Library, Build Readiness
# Report, State Logic Builder, Calendar) — see each of their .env.example.
SDC_SESSION_SECRET=change-this-to-a-random-64-char-string

# ─── Build Readiness integration ─────────────────────────────────────────
# Build Readiness Report reads project build-start/ship dates from this app
# (routes/integration.js) via this token — MUST match the same var in
# Build_Readiness_Report/.env.
READINESS_SHARED_TOKEN=change-this-to-a-random-64-char-string

# ─── SDC Tools ↔ SDC Reports (ETC Planner) integration ───────────────────
# Two independent uses of the SAME shared secret: user SSO (routes/auth.js's
# /api/auth/sso inbound, /api/auth/mint-etc-sso outbound — the sign-in
# hand-off both directions, plus what the Electron shell's
# mintEtcSsoHopToken() calls to open Reports pre-signed-in) and password-hash
# sync, so the same person's password stays identical on both apps' own
# native login forms. MUST match the identically-named SCHEDULER_SHARED_TOKEN
# in sdc-etc-planner's own .env.
SCHEDULER_SHARED_TOKEN=change-this-to-a-random-64-char-string

# Reports' own base URL, used by lib/plannerClient.js for server-to-server calls.
ETC_PLANNER_URL=http://localhost:4006

# Least-privilege MySQL user with SELECT/INSERT/UPDATE on
# sdc_etc_planner.Employee ONLY (not the root credential above) — shared
# Employee table sync between this app and Reports. Until set,
# lib/mysqlDb.js's getEtcPool() fails soft rather than guessing a connection.
# ETC_SHARED_DATABASE_URL=mysql://user:password@127.0.0.1:3306/sdc_etc_planner
